<%@ Master Language="C#" AutoEventWireup="true" CodeBehind="Site.Master.cs"
    Inherits="Es.Udc.DotNet.PracticaMAD.Web.SiteMaster" %>
<!DOCTYPE html>
<html lang="es">
<head runat="server">
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title></title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css"
        rel="stylesheet"
        integrity="sha384-sRIl4kxILFvY47J16cr9ZwB07vP4J8+LH7qKQnuqkuIAvNWLzeN8tE5YBujZqJLB"
        crossorigin="anonymous" />
    <link href="~/Css/styles.css" rel="stylesheet" runat="server" />
</head>
<body class="bootstrap-layout">
    <div id="window">
        <form id="siteForm" runat="server">
            <nav class="navbar bg-white border-bottom" aria-label="Navegación principal">
                <div class="container flex-wrap gap-2">
                    <asp:HyperLink ID="lnkHome" runat="server" CssClass="navbar-brand fw-bold"
                        NavigateUrl="~/Pages/MainPage.aspx" meta:resourcekey="lnkHome" />
                    <div class="d-flex flex-wrap align-items-center gap-3">
                        <asp:PlaceHolder ID="anonymousLinks" runat="server">
                            <asp:HyperLink ID="lnkLogin" runat="server" NavigateUrl="~/Pages/User/Login.aspx" meta:resourcekey="lnkLogin" />
                            <asp:HyperLink ID="lnkRegister" runat="server" NavigateUrl="~/Pages/User/Register.aspx" meta:resourcekey="lnkRegister" />
                        </asp:PlaceHolder>
                        <asp:PlaceHolder ID="authenticatedLinks" runat="server" Visible="false">
                            <span><asp:Literal ID="litFirstName" runat="server" Mode="Encode" /></span>
                            <asp:HyperLink ID="lnkUpdateProfile" runat="server" NavigateUrl="~/Pages/User/UpdateProfile.aspx"
                                meta:resourcekey="lnkUpdateProfile" />
                            <asp:LinkButton ID="btnLogout" runat="server" CausesValidation="false"
                                OnClick="BtnLogoutClick" meta:resourcekey="btnLogout" />
                        </asp:PlaceHolder>
                    </div>
                </div>
            </nav>
            <main id="content">
                <asp:ContentPlaceHolder ID="MainContent" runat="server" />
            </main>
        </form>
    </div>
</body>
</html>
